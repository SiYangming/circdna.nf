/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests with gDNA control
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test dataset with gDNA control samples for ECCsplorer comparative analysis.
    Uses test_local_gdna.csv which contains 3 eccDNA + 3 gDNA samples
    paired by the 'group' column.
*/

params {
    config_profile_name        = 'Test local profile with gDNA control'
    config_profile_description = 'Test dataset with gDNA control samples for ECCsplorer comparative analysis'

    // Limit resources so that this can run locally smoothly
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '6.h'

    // Input data
    input   = '/Users/siyangming/nextflow_nf_core/circdna.nf/samplesheets/test_local_gdna.csv'
    input_format   = 'FASTQ'

    // Output directory
    outdir  = 'results/test_local_gdna'

    // Genome references
    fasta               = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/reference/genome.fa'
    fasta_base_path     = null
    igenomes_ignore     = true

    // Extra references
    cnvkit_cnn          = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/cnvkit/dummy_file.cnn'
    mosek_license_dir   = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/mosek/'

    // Pipeline mode
    mode    = 'eccdna'

    // Repeat annotation (optional)
    repeat_gff          = null

    // ECCsplorer BLAST annotation database
    eccsplorer_database = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/eccsplorer_db/eccsplorer_db.fa'

    // Needed input
    skip_markduplicates = false

    reference_build     = "GRCh38"
}

// Override process resource limits for local execution specifically
process {
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 4    * task.attempt }
        memory = { 8.GB * task.attempt }
    }

    withName: 'CIRCLEMAP_REALIGN' {
        cpus = 1
    }

    withName: 'TRIMGALORE' {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }

    withName: 'UNICYCLER' {
        ext.args = "--no_rotate --kmers 27 --spades_options '-m 8192'"
    }

    withName: '.*PICARD_MARKDUPLICATES' {
        ext.args = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
    }

    withName: 'BWA_INDEX' {
        cpus   = 1
        memory = 4.GB
    }
}

// Local testing conventions

// Overwrite trace/report files to avoid warnings
trace.overwrite = true
report.overwrite = true
timeline.overwrite = true
