/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running local tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test locally.
*/

params {
    config_profile_name        = 'Test local profile'
    config_profile_description = 'Minimal test dataset to check pipeline function locally'

    // Limit resources so that this can run locally smoothly
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '6.h'

    // Input data
    input   = '/Users/siyangming/nextflow_nf_core/circdna.nf/samplesheets/test_local_eccdna.csv'
    input_format   = 'FASTQ'

    // Genome references
    fasta               = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/reference/genome.fa'
    fasta_base_path     = null
    // circle_identifier - eccsplorer 子模式控制：
    //   eccsplorer_map → map only; eccsplorer_clu → map + clu (auto-enables map)
    //   原版（黑盒模式）: eccsplorer_map,ecc_finder_map_sr,ecc_finder_asm_sr
    //   slim 版（原子化）: eccsplorer_map_slim,ecc_finder_map_sr_slim,ecc_finder_asm_sr_slim
    circle_identifier   = 'eccsplorer_map_slim,ecc_finder_map_sr_slim,ecc_finder_asm_sr_slim'
    igenomes_ignore     = true

    // Extra references (if used by specific modules like AmpliconArchitect)
    cnvkit_cnn          = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/cnvkit/dummy_file.cnn'
    mosek_license_dir   = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/mosek/'
    aa_data_repo        = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/aa_data_repo/'

    // Pipeline mode (can be overridden with --mode on command line)
    mode    = 'eccdna'

    // Repeat annotation (optional)
    repeat_gff          = null

    // ECCsplorer BLAST annotation database
    // PublicDB (Dfam/RepBase) is accessed via Docker volume or container path; not needed as file param
    eccsplorer_database = null

    // Needed input
    skip_markduplicates = false

    reference_build     = "GRCh38"

    // Output directory
    outdir  = 'results/test_local'
}

// Override process resource limits for local execution specifically
process {
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 4    * task.attempt }
        memory = { 8.GB * task.attempt }
    }

    // Force single-thread for Circle-Map Realign on small test datasets.
    // Multi-process cluster splitting in Circle-Map raises
    //   "An error happenend during execution. Exiting"
    // when candidate cluster count < threads (typical for tiny test BAMs).
    // Production / large samples should NOT need this override.
    withName: 'CIRCLEMAP_REALIGN' {
        cpus = 1
    }

    // Override TRIMGALORE resources for local testing
    // Default process_medium requires 36GB, which exceeds typical local machine memory
    withName: 'TRIMGALORE' {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }

    withName: 'UNICYCLER' {
        ext.args = "--no_rotate --kmers 27 --spades_options '-m 8192'"
    }

    withName: '.*PICARD_MARKDUPLICATES' {
        ext.args = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
    }

    withName: 'BWA_INDEX' {
        cpus   = 1
        memory = 4.GB
    }
}

// Local testing conventions
//resume  = true

// Overwrite trace/report files to avoid warnings
trace.overwrite = true
report.overwrite = true
timeline.overwrite = true
