/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the long-read WGS background test (§4.4 LONG_READ_REFERENCE)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Asserts: long-read gdna/wgs rows only run preprocess → minimap2 → mosdepth,
    with NO detection engine (identifier list empty on purpose).
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test Long-read WGS profile'
    config_profile_description = 'Long-read WGS background test (minimap2 + mosdepth only)'

    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '12.h'

    input         = './samplesheets/test_lr_wgs.csv'
    input_format  = 'FASTQ'

    fasta           = "${projectDir}/testdatasets/reference/genome.fa"
    igenomes_ignore = true

    protocol             = 'pacbio'
    entrypoint           = 'cleaned_fastq'
    mode                 = 'eccdna'

    // 无检测引擎：验证 gdna 长读绝不进入 cresil/fled/flye/eccfinder/circleseeker/ciderseq
    long_read_identifier = ''
    circle_identifier    = ''
    skip_long_read_qc    = true

    outdir = 'results/test_lr_wgs'
}

process {
    withLabel:process_high {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
    withLabel:process_medium {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
    withLabel:process_low {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
    withName: 'MINIMAP2_REFERENCE|SAMTOOLS_SORT_REFERENCE|SAMTOOLS_INDEX_REFERENCE|MOSDEPTH_LR_REF' {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
}
