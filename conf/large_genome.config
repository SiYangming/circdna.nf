//
// 大基因组配置：使用 CSI 索引支持 >512Mb 染色体
// 适用物种：Alopecurus_myosuroides（黑麦草）、Triticum_aestivum（小麦）等
// 用法: -profile server -c conf/large_genome.config
//

params {
    use_csi_index = true
}

process {
    // 精确覆盖 modules.config 中设了 ext.args = "" 的 alias
    withName: 'SAMTOOLS_INDEX_BAM' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_FILTERED' {
        ext.args = '-c'
    }
    withName: 'SAMTOOLS_INDEX_RE' {
        ext.args = '-c'
    }
    // BAM_MARKDUPLICATES_PICARD 内部的 SAMTOOLS_INDEX（modules.config 用正则匹配）
    withName: '.*BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX' {
        ext.args = '-c'
    }
}
