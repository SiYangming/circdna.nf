/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Integrated Mode tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Tests the full Integrated Mode pipeline with both gDNA and eccDNA samples.
    Uses --mode integrated to run Reference + eccDNA + ECC_SCORE pipeline.

    Use as follows:
        nextflow run main.nf -profile test_integrated,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test Integrated Mode profile'
    config_profile_description = 'Integrated Mode test dataset with gDNA + eccDNA samples'

    // Limit resources so that this can run locally smoothly
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '6.h'

    // Input data - contains both gDNA and eccDNA samples with datatype field
    input   = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/samplesheet/samplesheet_integrated.csv'
    input_format   = 'FASTQ'

    // Pipeline mode
    mode    = 'integrated'

    // Genome references
    fasta               = '/Users/siyangming/nextflow_nf_core/circdna.nf/testdatasets/reference/genome.fa'
    fasta_base_path     = null
    igenomes_ignore     = true

    // ECC_SCORE weights
    ecc_score_w1        = 1.0
    ecc_score_w2        = 1.0
    ecc_score_w3        = 0.5

    // Repeat annotation (optional - set to null to skip)
    repeat_gff          = null

    // Needed input
    skip_markduplicates = false
}

// Override process resource limits for local execution specifically
process {
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 4    * task.attempt }
        memory = { 8.GB * task.attempt }
    }

    // Override TRIMGALORE resources for local testing
    withName: 'TRIMGALORE' {
        cpus   = 2
        memory = 4.GB
        time   = 2.h
    }

    withName: '.*PICARD_MARKDUPLICATES' {
        ext.args = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
    }

    withName: 'BWA_INDEX' {
        cpus   = 1
        memory = 4.GB
    }
}

// Local testing conventions
workDir = './nextflow_work'

// Overwrite trace/report files to avoid warnings
trace.overwrite = true
report.overwrite = true
timeline.overwrite = true
