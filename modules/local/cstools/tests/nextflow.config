docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
    fixOwnership = true
}

process {
    withLabel: process_low {
        cpus   = 2
        memory = '6.GB'
        time   = '6.h'
    }
    withName: 'CIDERSEQ_SEPARATE|CIDERSEQ_ALIGN|CIDERSEQ_DECONCAT|CIDERSEQ_ANNOTATE|CIDERSEQ_PHASE|CS_ECCDNA|CSTOOLS' {
        publishDir = [ enabled: false ]
    }
    // exercise cs-tools.py 'split' in the module test
    withName: 'CSTOOLS' {
        ext.args = 'split --format fastq --numjobs 2 --mode full'
    }
}
