nextflow_process {

    name "Test Process FIND_CIRC_ANCHORS"
    script "../main.nf"
    process "FIND_CIRC_ANCHORS"

    tag "modules"
    tag "modules_local"
    tag "find_circ"
    tag "find_circ/anchors"

    test("test-anchors - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ],
                            file("${projectDir}/modules/local/find_circ/testdata/CDR1as_locus.fa", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.anchors.get(0).get(1)).exists() },
                { assert path(process.out.versions.get(0)).exists() }
            )
        }

    }

}
