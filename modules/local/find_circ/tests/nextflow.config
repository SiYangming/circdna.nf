process {
    withName: 'SAMTOOLS_VIEW_UNMAPPED_FC|BOWTIE2_BUILD|FIND_CIRC_ANCHORS|FIND_CIRC|FIND_CIRC_FILTER' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'FIND_CIRC' {
        ext.args = '--noncanonical'
    }
    withName: 'SAMTOOLS_VIEW_UNMAPPED_FC' {
        ext.args   = '-b -f 4'
        ext.prefix = { "${meta.id}.unmapped" }
    }
}
