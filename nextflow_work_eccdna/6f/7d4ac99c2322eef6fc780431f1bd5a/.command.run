#!/bin/bash
### ---
### name: 'NFCORE_CIRCDNA:CIRCDNA:MULTIQC'
### container: 'community.wave.seqera.io/library/multiqc:1.35--c17fb751507e9dfc'
### outputs:
### - '*multiqc_report.html'
### - '*_data'
### - '*_plots'
### - 'versions.yml'
### ...
set -e
set -u
NXF_DEBUG=${NXF_DEBUG:=0}; [[ $NXF_DEBUG > 1 ]] && set -x
NXF_ENTRY=${1:-nxf_main}

nxf_tree() {
    local pid=$1

    declare -a ALL_CHILDREN
    while read P PP;do
        ALL_CHILDREN[$PP]+=" $P"
    done < <(ps -e -o pid= -o ppid=)

    pstat() {
        local x_pid=$1
        local STATUS=$(2> /dev/null < /proc/$1/status grep -E 'Vm|ctxt')

        if [ $? = 0 ]; then
        local  x_vsz=$(echo "$STATUS" | grep VmSize | awk '{print $2}' || echo -n '0')
        local  x_rss=$(echo "$STATUS" | grep VmRSS | awk '{print $2}' || echo -n '0')
        local x_peak=$(echo "$STATUS" | grep -E 'VmPeak|VmHWM' | sed 's/^.*:\s*//' | sed 's/[\sa-zA-Z]*$//' | tr '\n' ' ' || echo -n '0 0')
        local x_pmem=$(awk -v rss=$x_rss -v mem_tot=$mem_tot 'BEGIN {printf "%.0f", rss/mem_tot*100*10}' || echo -n '0')
        local vol_ctxt=$(echo "$STATUS" | grep '\bvoluntary_ctxt_switches' | awk '{print $2}' || echo -n '0')
        local inv_ctxt=$(echo "$STATUS" | grep '\bnonvoluntary_ctxt_switches' | awk '{print $2}' || echo -n '0')
        cpu_stat[x_pid]="$x_pid $x_pmem $x_vsz $x_rss $x_peak $vol_ctxt $inv_ctxt"
        fi
    }

    pwalk() {
        pstat $1
        for i in ${ALL_CHILDREN[$1]:=}; do pwalk $i; done
    }

    pwalk $1
}

nxf_stat() {
    cpu_stat=()
    nxf_tree $1

    declare -a sum=(0 0 0 0 0 0 0 0)
    local pid
    local i
    for pid in "${!cpu_stat[@]}"; do
        local row=(${cpu_stat[pid]})
        [ $NXF_DEBUG = 1 ] && echo "++ stat mem=${row[*]}"
        for i in "${!row[@]}"; do
        if [ $i != 0 ]; then
            sum[i]=$((sum[i]+row[i]))
        fi
        done
    done

    [ $NXF_DEBUG = 1 ] && echo -e "++ stat SUM=${sum[*]}"

    for i in {1..7}; do
        if [ ${sum[i]} -lt ${cpu_peak[i]} ]; then
            sum[i]=${cpu_peak[i]}
        else
            cpu_peak[i]=${sum[i]}
        fi
    done

    [ $NXF_DEBUG = 1 ] && echo -e "++ stat PEAK=${sum[*]}\n"
    nxf_stat_ret=(${sum[*]})
}

nxf_mem_watch() {
    set -o pipefail
    local pid=$1
    local trace_file=.command.trace
    local count=0;
    declare -a cpu_stat=(0 0 0 0 0 0 0 0)
    declare -a cpu_peak=(0 0 0 0 0 0 0 0)
    local mem_tot=$(< /proc/meminfo grep MemTotal | awk '{print $2}')
    local timeout
    local DONE
    local STOP=''

    [ $NXF_DEBUG = 1 ] && nxf_sleep 0.2 && ps fx

    while true; do
        nxf_stat $pid
        if [ $count -lt 10 ]; then timeout=1;
        elif [ $count -lt 120 ]; then timeout=5;
        else timeout=30;
        fi
        read -t $timeout -r DONE || true
        [[ $DONE ]] && break
        if [ ! -e /proc/$pid ]; then
            [ ! $STOP ] && STOP=$(nxf_date)
            [ $(($(nxf_date)-STOP)) -gt 10000 ] && break
        fi
        count=$((count+1))
    done

    printf "%s\n" \
        "%mem=${nxf_stat_ret[1]}" \
        "vmem=${nxf_stat_ret[2]}" \
        "rss=${nxf_stat_ret[3]}" \
        "peak_vmem=${nxf_stat_ret[4]}" \
        "peak_rss=${nxf_stat_ret[5]}" \
        "vol_ctxt=${nxf_stat_ret[6]}" \
        "inv_ctxt=${nxf_stat_ret[7]}" >> "$trace_file" || >&2 echo "Error: Failed to append to file: $trace_file"
}

nxf_write_trace() {
    printf "%s\n" \
        "nextflow.trace/v2" \
        "realtime=$wall_time" \
        "%cpu=$ucpu" \
        "cpu_model=$cpu_model" \
        "rchar=${io_stat1[0]}" \
        "wchar=${io_stat1[1]}" \
        "syscr=${io_stat1[2]}" \
        "syscw=${io_stat1[3]}" \
        "read_bytes=${io_stat1[4]}" \
        "write_bytes=${io_stat1[5]}" >| "$trace_file" || >&2 echo "Error: Failed to write to file: $trace_file"
}

nxf_trace_mac() {
    local start_millis=$(nxf_date)

    /usr/bin/env bash -C -e -u -o pipefail /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/6f/7d4ac99c2322eef6fc780431f1bd5a/.command.sh

    local end_millis=$(nxf_date)
    local wall_time=$((end_millis-start_millis))
    local ucpu=''
    local cpu_model=''
    local io_stat1=('' '' '' '' '' '')
    nxf_write_trace
}

nxf_fd() {
    local FD=11
    while [ -e /proc/$$/fd/$FD ]; do FD=$((FD+1)); done
    echo $FD
}

nxf_trace_linux() {
    local pid=$$
    command -v ps &>/dev/null || { >&2 echo "Command 'ps' required by nextflow to collect task metrics cannot be found"; exit 1; }
    local num_cpus=$(< /proc/cpuinfo grep '^processor' -c)
    local cpu_model=$(< /proc/cpuinfo grep '^model name' | head -n 1 | awk 'BEGIN{FS="\t: "} { print $2 }')
    local tot_time0=$(grep '^cpu ' /proc/stat | awk '{sum=$2+$3+$4+$5+$6+$7+$8+$9; printf "%.0f",sum}')
    local cpu_time0=$(2> /dev/null < /proc/$pid/stat awk '{printf "%.0f", ($16+$17)*10 }' || echo -n 'X')
    local io_stat0=($(2> /dev/null < /proc/$pid/io sed 's/^.*:\s*//' | head -n 6 | tr '\n' ' ' || echo -n '0 0 0 0 0 0'))
    local start_millis=$(nxf_date)
    trap 'kill $mem_proc' ERR
    
    /usr/bin/env bash -C -e -u -o pipefail /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/6f/7d4ac99c2322eef6fc780431f1bd5a/.command.sh &
    local task=$!

    mem_fd=$(nxf_fd)
    eval "exec $mem_fd> >(nxf_mem_watch $task)"
    local mem_proc=$!

    wait $task

    local end_millis=$(nxf_date)
    local tot_time1=$(grep '^cpu ' /proc/stat | awk '{sum=$2+$3+$4+$5+$6+$7+$8+$9; printf "%.0f",sum}')
    local cpu_time1=$(2> /dev/null < /proc/$pid/stat awk '{printf "%.0f", ($16+$17)*10 }' || echo -n 'X')
    local ucpu=$(awk -v p1=$cpu_time1 -v p0=$cpu_time0 -v t1=$tot_time1 -v t0=$tot_time0 -v n=$num_cpus 'BEGIN { pct=(p1-p0)/(t1-t0)*100*n; printf("%.0f", pct>0 ? pct : 0) }' )

    local io_stat1=($(2> /dev/null < /proc/$pid/io sed 's/^.*:\s*//' | head -n 6 | tr '\n' ' ' || echo -n '0 0 0 0 0 0'))
    local i
    for i in {0..5}; do
        io_stat1[i]=$((io_stat1[i]-io_stat0[i]))
    done

    local wall_time=$((end_millis-start_millis))
    [ $NXF_DEBUG = 1 ] && echo "+++ STATS %CPU=$ucpu TIME=$wall_time I/O=${io_stat1[*]}"

    printf "%s\n" \
        "nextflow.trace/v2" \
        "realtime=$wall_time" \
        "%cpu=$ucpu" \
        "cpu_model=$cpu_model" \
        "rchar=${io_stat1[0]}" \
        "wchar=${io_stat1[1]}" \
        "syscr=${io_stat1[2]}" \
        "syscw=${io_stat1[3]}" \
        "read_bytes=${io_stat1[4]}" \
        "write_bytes=${io_stat1[5]}" >| "$trace_file" || >&2 echo "Error: Failed to write to file: $trace_file"

    [ -e /proc/$mem_proc ] && eval "echo 'DONE' >&$mem_fd" || true
    wait $mem_proc 2>/dev/null || true
    while [ -e /proc/$mem_proc ]; do nxf_sleep 0.1; done
}

nxf_trace() {
    local trace_file=.command.trace
    touch $trace_file
    if [[ $(uname) = Darwin ]]; then
        nxf_trace_mac
    else
        nxf_trace_linux
    fi
}
nxf_container_env() {
cat << EOF
export PYTHONNOUSERSITE="1"
export R_PROFILE_USER="/.Rprofile"
export R_ENVIRON_USER="/.Renviron"
export JULIA_DEPOT_PATH="/usr/local/share/julia"
export PATH="\$PATH:/Users/siyangming/nextflow_nf_core/circdna.nf/bin"
EOF
}

nxf_sleep() {
  sleep $1 2>/dev/null || sleep 1;
}

nxf_date() {
    local s n
    read s n < <(date '+%s %N')
    if [[ $n =~ ^[0-9]+$ ]]; then
        n=$(printf '%09d' "$((10#$n))")
        echo "$((s * 1000 + 10#${n:0:3}))"
    else
        echo "$((s * 1000))"
    fi
}

nxf_env() {
    echo '============= task environment ============='
    env | sort | sed "s/\(.*\)AWS\(.*\)=\(.\{6\}\).*/\1AWS\2=\3xxxxxxxxxxxxx/"
    echo '============= task output =================='
}

nxf_kill() {
    declare -a children
    while read P PP;do
        children[$PP]+=" $P"
    done < <(ps -e -o pid= -o ppid=)

    kill_all() {
        [[ $1 != $$ ]] && kill $1 2>/dev/null || true
        for i in ${children[$1]:=}; do kill_all $i; done
    }

    kill_all $1
}

nxf_mktemp() {
    local base=${1:-/tmp}
    mkdir -p "$base"
    if [[ $(uname) = Darwin ]]; then mktemp -d $base/nxf.XXXXXXXXXX
    else TMPDIR="$base" mktemp -d -t nxf.XXXXXXXXXX
    fi
}

nxf_fs_copy() {
  local source=$1
  local target=$2
  local basedir=$(dirname $1)
  mkdir -p $target/$basedir
  cp -fRL $source $target/$basedir
}

nxf_fs_move() {
  local source=$1
  local target=$2
  local basedir=$(dirname $1)
  mkdir -p $target/$basedir
  mv -f $source $target/$basedir
}

nxf_fs_rsync() {
  local source=$1
  local target=$2
  mkdir -p $target
  rsync -rRl $source $target
}

nxf_fs_rclone() {
  rclone copyto $1 $2/$1
}

nxf_fs_fcp() {
  fcp $1 $2/$1
}

on_exit() {
    local last_err=$?
    local exit_status=${nxf_main_ret:=0}
    [[ ${exit_status} -eq 0 && ${nxf_unstage_ret:=0} -ne 0 ]] && exit_status=${nxf_unstage_ret:=0}
    [[ ${exit_status} -eq 0 && ${last_err} -ne 0 ]] && exit_status=${last_err}
    printf -- $exit_status > /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/6f/7d4ac99c2322eef6fc780431f1bd5a/.exitcode
    set +u
    docker rm $NXF_BOXID &>/dev/null || true
    exit $exit_status
}

on_term() {
    set +e
    docker stop $NXF_BOXID
}

nxf_launch() {
    docker run -i --cpu-shares 1024 --memory 6144m -e "NXF_TASK_WORKDIR" -e "NXF_DEBUG=${NXF_DEBUG:=0}" -v /Users/siyangming/nextflow_nf_core/circdna.nf:/Users/siyangming/nextflow_nf_core/circdna.nf -w "$NXF_TASK_WORKDIR" -u $(id -u):$(id -g) --name $NXF_BOXID community.wave.seqera.io/library/multiqc:1.35--c17fb751507e9dfc /bin/bash -c "eval $(nxf_container_env); bash -C -e -u -o pipefail /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/6f/7d4ac99c2322eef6fc780431f1bd5a/.command.run nxf_trace"
}

nxf_stage() {
    true
    # stage input files
    rm -f 11/circdna_2.zip
    rm -f 5/circdna_3.trimmed_1.fastq.gz_trimming_report.txt
    rm -f 6/circdna_3.trimmed_2.fastq.gz_trimming_report.txt
    rm -f 9/circdna_3.zip
    rm -f 13/circdna_3.mosdepth.summary.txt
    rm -f 14/circdna_2.mosdepth.summary.txt
    rm -f 4/circdna_1.trimmed_2.fastq.gz_trimming_report.txt
    rm -f 8/circdna_2.trimmed_2.fastq.gz_trimming_report.txt
    rm -f 12/circdna_1.mosdepth.summary.txt
    rm -f 15/software_versions_mqc.yml
    rm -f 3/circdna_1.trimmed_1.fastq.gz_trimming_report.txt
    rm -f multiqc_config.yml
    rm -f 2/workflow_summary_mqc.yaml
    rm -f 10/circdna_1.zip
    rm -f 1/methods_description_mqc.yaml
    rm -f 7/circdna_2.trimmed_1.fastq.gz_trimming_report.txt
    mkdir -p 11 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/25/ba97c6776bb76fd11400c77bfb341f/circdna_2.zip 11/circdna_2.zip
    mkdir -p 5 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/d6/5d9356c858b8ca5b6d7b79054b7d4f/circdna_3.trimmed_1.fastq.gz_trimming_report.txt 5/circdna_3.trimmed_1.fastq.gz_trimming_report.txt
    mkdir -p 6 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/d6/5d9356c858b8ca5b6d7b79054b7d4f/circdna_3.trimmed_2.fastq.gz_trimming_report.txt 6/circdna_3.trimmed_2.fastq.gz_trimming_report.txt
    mkdir -p 9 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/38/292ccd34142656f026f7680458c6d5/circdna_3.zip 9/circdna_3.zip
    mkdir -p 13 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/7a/e0791c447e8202cf78259f4cd2f135/circdna_3.mosdepth.summary.txt 13/circdna_3.mosdepth.summary.txt
    mkdir -p 14 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/06/8416479744566656488d97d363a28d/circdna_2.mosdepth.summary.txt 14/circdna_2.mosdepth.summary.txt
    mkdir -p 4 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/e5/e17f8ca9b260fd18c912d38d22609c/circdna_1.trimmed_2.fastq.gz_trimming_report.txt 4/circdna_1.trimmed_2.fastq.gz_trimming_report.txt
    mkdir -p 8 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/32/d4236d60c819522325bc6252343206/circdna_2.trimmed_2.fastq.gz_trimming_report.txt 8/circdna_2.trimmed_2.fastq.gz_trimming_report.txt
    mkdir -p 12 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/61/caab28127fd80375c4c0998a3b64f6/circdna_1.mosdepth.summary.txt 12/circdna_1.mosdepth.summary.txt
    mkdir -p 15 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/tmp/73/6bb19e6989cd36a670a157e57ff2da/software_versions_mqc.yml 15/software_versions_mqc.yml
    mkdir -p 3 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/e5/e17f8ca9b260fd18c912d38d22609c/circdna_1.trimmed_1.fastq.gz_trimming_report.txt 3/circdna_1.trimmed_1.fastq.gz_trimming_report.txt
    ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/assets/multiqc_config.yml multiqc_config.yml
    mkdir -p 2 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/tmp/76/333ef56266a2b3ecd60d568fe322fe/workflow_summary_mqc.yaml 2/workflow_summary_mqc.yaml
    mkdir -p 10 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/93/c4a4dcbfa154357cdb07ba6baf4685/circdna_1.zip 10/circdna_1.zip
    mkdir -p 1 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/tmp/79/9df0ce1b1e2d9f38c9524944844947/methods_description_mqc.yaml 1/methods_description_mqc.yaml
    mkdir -p 7 && ln -s /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/32/d4236d60c819522325bc6252343206/circdna_2.trimmed_1.fastq.gz_trimming_report.txt 7/circdna_2.trimmed_1.fastq.gz_trimming_report.txt
}

nxf_unstage_outputs() {
    true
}

nxf_unstage_controls() {
    true
}

nxf_unstage() {
    if [[ ${nxf_main_ret:=0} == 0 ]]; then
        (set -e -o pipefail; (nxf_unstage_outputs | tee -a .command.out) 3>&1 1>&2 2>&3 | tee -a .command.err)
        nxf_unstage_ret=$?
    fi
    nxf_unstage_controls
}

nxf_main() {
    trap on_exit EXIT
    trap on_term TERM INT USR2
    trap '' USR1

    [[ "${NXF_CHDIR:-}" ]] && cd "$NXF_CHDIR"
    export NXF_BOXID="nxf-$(dd bs=18 count=1 if=/dev/urandom 2>/dev/null | base64 | tr +/ 0A | tr -d '\r\n')"
    NXF_SCRATCH=''
    [[ $NXF_DEBUG > 0 ]] && nxf_env
    touch /Users/siyangming/nextflow_nf_core/circdna.nf/nextflow_work_eccdna/6f/7d4ac99c2322eef6fc780431f1bd5a/.command.begin
    set +u
    set -u
    [[ $NXF_SCRATCH ]] && cd $NXF_SCRATCH
    export NXF_TASK_WORKDIR="$PWD"
    nxf_stage

    set +e
    (set -o pipefail; (nxf_launch | tee .command.out) 3>&1 1>&2 2>&3 | tee .command.err) &
    pid=$!
    wait $pid || nxf_main_ret=$?
    nxf_unstage
}

$NXF_ENTRY
